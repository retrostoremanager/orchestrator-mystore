# orchestrator-mystore instance config -- sourced by scripts/dispatch-tasks.sh.

PROJECT_NAME="RetroStoreManager"
TARGET_BRANCH="development"
PR_LINK_PHRASE="Closes"

# Per-target-repo build commands. Looked up by lookup_build_cmd() via bash
# indirect expansion against BUILD_<UPPERCASE_REPO_WITH_UNDERSCORES>.
BUILD_FN_MYSTORE="dotnet build MyStore.sln && dotnet test MyStore.Tests/MyStore.Tests.csproj"
BUILD_DBPROJ_MYSTORE="echo 'SQL migration -- no build step required'"
BUILD_WEB_MYSTORE="npm install && npm run build && npm test -- --run"

# Fallback for any repo not explicitly listed above.
BUILD_DEFAULT="npm install && npm run build && npm test -- --run"
